<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-padding: 20px;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.bushraController.MajorEventsViewController">
    <children>
        <Label text="Goal 1: Major Event Approval Queue">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Label text="Filter applied: Budget &gt; 50,000 BDT or Inter-University Scope" textFill="#666666" />

        <TableView fx:id="tvPendingMajorEvents" prefHeight="400.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colEventName" prefWidth="200.0" text="Event Name" />
                <TableColumn fx:id="colClubName" prefWidth="150.0" text="Organizing Club" />
                <TableColumn fx:id="colRequestedBudget" prefWidth="130.0" text="Budget (BDT)" />
                <TableColumn fx:id="colEventDate" prefWidth="120.0" text="Event Date" />
                <TableColumn fx:id="colRiskLevel" prefWidth="100.0" text="Risk Level" />
            </columns>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleApprove" style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-weight: bold;" text="Approve Selected" />
                <Button mnemonicParsing="false" onAction="#handleReject" style="-fx-background-color: #C0392B; -fx-text-fill: white; -fx-font-weight: bold;" text="Reject Selected" />
            </children>
        </HBox>
    </children>
</VBox>
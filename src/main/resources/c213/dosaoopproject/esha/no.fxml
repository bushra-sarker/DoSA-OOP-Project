<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.esha.controller.u6_G3_AssignVolunteers">
   <children>
      <VBox spacing="15">
      
          <padding>
            <Insets bottom="10" left="10" right="10" top="10" />
         </padding>
      
          <Label style="-fx-font-size:20px; -fx-font-weight:bold;" text="Approve Volunteer Hours &amp; Issue Certificates" />
      
          <TableView fx:id="recordsTable" prefHeight="320">
              <columns>
                  <TableColumn fx:id="approvalIdColumn" prefWidth="90" text="Approval ID" />
                  <TableColumn fx:id="volunteerIdColumn" prefWidth="100" text="Volunteer ID" />
                  <TableColumn fx:id="totalHoursColumn" prefWidth="100" text="Total Hours" />
                  <TableColumn fx:id="hourStatusColumn" prefWidth="110" text="Hour Status" />
                  <TableColumn fx:id="certificateStatusColumn" prefWidth="140" text="Certificate Status" />
              </columns>
          </TableView>
      
          <Label fx:id="statusLabel" />
      
          <HBox spacing="10">
              <Button fx:id="approveHoursBtn" onAction="#handleApproveHours" text="Approve Hours" />
              <Button fx:id="checkEligibilityBtn" onAction="#handleCheckEligibility" text="Check Certificate Eligibility" />
              <Button fx:id="generateCertificateBtn" onAction="#handleGenerateCertificate" text="Generate Certificate" />
              <Button fx:id="refreshBtn" onAction="#handleRefresh" text="Refresh" />
          </HBox>
      
      </VBox>
      <VBox spacing="15">
      
          <padding>
            <Insets bottom="10" left="10" right="10" top="10" />
         </padding>
      
          <Label style="-fx-font-size:20px; -fx-font-weight:bold;" text="Approve Volunteer Hours &amp; Issue Certificates" />
      
          <TableView fx:id="hoursTable" prefHeight="320">
              <columns>
                  <TableColumn fx:id="approvalIdColumn1" prefWidth="90" text="Approval ID" />
                  <TableColumn fx:id="volunteerIdColumn1" prefWidth="100" text="Volunteer ID" />
                  <TableColumn fx:id="totalHoursColumn1" prefWidth="100" text="Total Hours" />
                  <TableColumn fx:id="hourStatusColumn1" prefWidth="110" text="Hour Status" />
                  <TableColumn fx:id="certificateStatusColumn1" prefWidth="140" text="Certificate Status" />
              </columns>
          </TableView>
      
          <Label fx:id="statusLabel1" />
      
          <HBox spacing="10">
              <Button fx:id="approveHoursBtn1" onAction="#handleApproveHours" text="Approve Hours" />
              <Button fx:id="checkEligibilityBtn1" onAction="#handleCheckEligibility" text="Check Eligibility" />
              <Button fx:id="generateCertificateBtn1" onAction="#handleGenerateCertificate" text="Generate Certificate" />
              <Button fx:id="refreshBtn1" onAction="#handleRefresh" text="Refresh" />
          </HBox>
      
      </VBox>
   </children>
</AnchorPane>

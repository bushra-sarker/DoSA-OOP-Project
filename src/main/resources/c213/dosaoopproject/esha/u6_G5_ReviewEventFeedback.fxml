<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.esha.controller.u6_G5_ReviewEventFeedback">

    <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>

    <Label style="-fx-font-size:20px; -fx-font-weight:bold;" text="Review Event Feedback" />

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Filter by Activity:" />
        <ComboBox fx:id="activityFilterCombo" prefWidth="220" />
        <Button fx:id="applyFilterBtn" onAction="#handleApplyFilter" text="Apply Filter" />
        <Button fx:id="clearFilterBtn" onAction="#handleClearFilter" text="Clear Filter" />
    </HBox>

    <TableView fx:id="feedbackTable" prefHeight="280">
        <columns>
            <TableColumn fx:id="feedbackIdColumn" prefWidth="100" text="Feedback ID" />
            <TableColumn fx:id="userIdColumn" prefWidth="90" text="User ID" />
            <TableColumn fx:id="activityNameColumn" prefWidth="180" text="Activity" />
            <TableColumn fx:id="ratingColumn" prefWidth="80" text="Rating" />
            <TableColumn fx:id="dateColumn" prefWidth="110" text="Date" />
            <TableColumn fx:id="flaggedColumn" prefWidth="80" text="Flagged" />
        </columns>
    </TableView>

    <Label style="-fx-font-weight:bold;" text="Comments:" />
    <TextArea fx:id="commentsArea" editable="false" prefRowCount="4" wrapText="true" />

    <Label fx:id="statusLabel" />

    <HBox spacing="10">
        <Button fx:id="flagBtn" onAction="#handleFlag" text="Flag for Follow-up" />
        <Button fx:id="unflagBtn" onAction="#handleUnflag" text="Unflag" />
        <Button fx:id="refreshBtn" onAction="#handleRefresh" text="Refresh" />
    </HBox>

    <Label fx:id="summaryLabel" style="-fx-font-style:italic; -fx-text-fill:#432D57;" />

</VBox>

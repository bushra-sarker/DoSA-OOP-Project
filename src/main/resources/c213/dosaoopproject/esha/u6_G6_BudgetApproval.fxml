<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.esha.controller.u6_G6_BudgetApproval">

    <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>

    <Label style="-fx-font-size:20px; -fx-font-weight:bold;" text="Event Budget Approval" />

    <TableView fx:id="budgetTable" prefHeight="280">
        <columns>
            <TableColumn fx:id="budgetIdColumn" prefWidth="90" text="Budget ID" />
            <TableColumn fx:id="executiveIdColumn" prefWidth="100" text="Executive ID" />
            <TableColumn fx:id="eventTypeColumn" prefWidth="140" text="Event Type" />
            <TableColumn fx:id="expectedDateColumn" prefWidth="120" text="Expected Date" />
            <TableColumn fx:id="estimatedAmountColumn" prefWidth="140" text="Estimated Amount" />
            <TableColumn fx:id="statusColumn" prefWidth="110" text="Status" />
        </columns>
    </TableView>

    <Label style="-fx-font-weight:bold;" text="Remarks (optional, shown to the Club Executive):" />
    <TextArea fx:id="remarksArea" prefRowCount="3" wrapText="true" />

    <Label fx:id="statusLabel" />

    <HBox spacing="10">
        <Button fx:id="approveBtn" onAction="#handleApprove" text="Approve" />
        <Button fx:id="rejectBtn" onAction="#handleReject" text="Reject" />
        <Button fx:id="refreshBtn" onAction="#handleRefresh" text="Refresh" />
    </HBox>

</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.esha.controller.PendingRequestsController">
   <children>
      <VBox spacing="12" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">

          <padding>
            <Insets bottom="10" left="10" right="10" top="10" />
         </padding>

          <Label style="-fx-font-size:20px; -fx-font-weight:bold;" text="Pending Requests from Club Executives" />

          <TableView fx:id="requestsTable" VBox.vgrow="ALWAYS">
              <columns>
                  <TableColumn fx:id="idColumn" prefWidth="60" text="ID" />
                  <TableColumn fx:id="typeColumn" prefWidth="140" text="Type" />
                  <TableColumn fx:id="detailsColumn" prefWidth="250" text="Details" />
                  <TableColumn fx:id="dateColumn" prefWidth="130" text="Submitted At" />
                  <TableColumn fx:id="statusColumn" prefWidth="90" text="Status" />
              </columns>
          </TableView>

          <Label text="Coordinator Note (optional):" style="-fx-font-weight:bold;" />
          <TextArea fx:id="noteArea" prefRowCount="2" promptText="Add a note for this decision..." />

          <HBox spacing="10">
              <Button fx:id="approveBtn" onAction="#handleApprove" text="✔ Approve" style="-fx-background-color:#4CAF50; -fx-text-fill:white; -fx-font-weight:bold;" />
              <Button fx:id="rejectBtn" onAction="#handleReject" text="✘ Reject" style="-fx-background-color:#f44336; -fx-text-fill:white; -fx-font-weight:bold;" />
              <Button fx:id="refreshBtn" onAction="#handleRefresh" text="↻ Refresh" />
          </HBox>

          <Label fx:id="statusLabel" />

      </VBox>
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.esha.controller.u6_G3_AssignVolunteers">
   <children>
      <VBox spacing="15" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">

          <padding>
            <Insets bottom="10" left="10" right="10" top="10" />
         </padding>

          <Label style="-fx-font-size:20px; -fx-font-weight:bold;" text="Assign Volunteers" />

          <TableView fx:id="hoursTable" VBox.vgrow="ALWAYS">
              <columns>
                  <TableColumn fx:id="approvalIdColumn" prefWidth="100" text="Approval ID" />
                  <TableColumn fx:id="volunteerIdColumn" prefWidth="100" text="Volunteer ID" />
                  <TableColumn fx:id="totalHoursColumn" prefWidth="120" text="Total Hours" />
                  <TableColumn fx:id="hourStatusColumn" prefWidth="120" text="Hour Status" />
                  <TableColumn fx:id="certificateStatusColumn" prefWidth="150" text="Certificate Status" />
              </columns>
          </TableView>

          <Label fx:id="statusLabel" />

          <HBox spacing="10">
              <Button fx:id="approveHoursBtn" onAction="#handleApproveHours" text="Approve Hours" />
              <Button fx:id="checkEligibilityBtn" onAction="#handleCheckEligibility" text="Check Eligibility" />
              <Button fx:id="generateCertificateBtn" onAction="#handleGenerateCertificate" text="Generate Certificate" />
              <Button fx:id="refreshBtn" onAction="#handleRefresh" text="Refresh" />
          </HBox>

      </VBox>
   </children>
</AnchorPane>

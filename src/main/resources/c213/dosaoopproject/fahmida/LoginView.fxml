<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="420.0" prefWidth="380.0" spacing="12.0"
      style="-fx-background-color: #083C57;" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="c213.dosaoopproject.fahmida.LoginViewController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/>
    </padding>

    <Label style="-fx-text-fill: white;" text="Division of Student Affairs (DoSA)"
           wrapText="true"/>
    <Label style="-fx-text-fill: #cfe3ef; -fx-font-size: 16px;" text="Login"/>

    <TextField fx:id="userIdTF" promptText="Enter User ID (e.g. STU01)"/>
    <PasswordField fx:id="passwordTF" promptText="Password"/>

    <Button defaultButton="true" maxWidth="Infinity" onAction="#loginOA"
            style="-fx-background-color: #1f6f9c; -fx-text-fill: white;"
            text="Login"/>

    <Label fx:id="errorLabel" style="-fx-text-fill: #ff8a80;" wrapText="true"/>
    <Label style="-fx-text-fill: #9fb8c8; -fx-font-size: 11px;" wrapText="true"
           text="Try STU01 / stu01 (Student) or ADV01 / adv01 (Club Advisor)"/>
</VBox>

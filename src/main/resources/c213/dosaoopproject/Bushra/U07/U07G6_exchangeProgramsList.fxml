<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="695.0" spacing="12.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.U07.controller.U07G6_ExchangeProgramsListController">
    <padding>
        <Insets bottom="15.0" left="12.0" right="12.0" top="15.0" />
    </padding>
    <children>
        <!-- HEADER BLOCK -->
        <VBox style="-fx-border-color: lightGray; -fx-background-radius: 8; -fx-border-radius: 8; -fx-background-color: white; -fx-padding: 12px;">
            <children>
                <Label text="Inter-University Exchange Nominations" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Label text="Review student eligibility, academic standings, and approve international nominations." textFill="GRAY">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- TABLE CARD -->
        <VBox spacing="10.0" style="-fx-background-color: white; -fx-border-color: lightgray; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 12px;">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Nomination Queue" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="totalCountLabel" text="Total: 0 items" textFill="GRAY">
                            <font>
                                <Font size="11.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
                <TableView fx:id="nominationsTableView" prefHeight="320.0">
                    <columns>
                        <TableColumn fx:id="colNominationId" prefWidth="100.0" text="Nomination ID" />
                        <TableColumn fx:id="colStudentName" prefWidth="150.0" text="Student Name" />
                        <TableColumn fx:id="colHostUniv" prefWidth="180.0" text="Host University" />
                        <TableColumn fx:id="colCgpa" prefWidth="80.0" text="CGPA" />
                        <TableColumn fx:id="colStatus" prefWidth="110.0" text="Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button fx:id="reviewNominationButton" disable="true" mnemonicParsing="false" onAction="#handleReviewNomination" prefHeight="32.0" prefWidth="160.0" style="-fx-background-color: #083C57; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="Review Nomination">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="530.0" prefWidth="720.0" spacing="8.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.U07.controller.U07G5_crisisDashboardController">
    <padding>
        <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
    </padding>
    <children>

        <!-- HEADER CARD -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 8px 10px;">
            <children>
                <Label text="Student Crisis Management" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Label text="Coordinate and monitor active student emergency cases." textFill="GRAY">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- SUMMARY CARDS SECTION -->
        <HBox spacing="8.0">
            <children>
                <!-- Card 1 -->
                <VBox alignment="CENTER" prefHeight="55.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 6px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="activeCasesLabel" text="0" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Label text="Active Cases" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Card 2 -->
                <VBox alignment="CENTER" prefHeight="55.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 6px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="highPriorityLabel" text="0" textFill="#bd2130">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Label text="High Priority" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Card 3 -->
                <VBox alignment="CENTER" prefHeight="55.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 6px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="inProgressLabel" text="0" textFill="#d39e00">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Label text="In Progress" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Card 4 -->
                <VBox alignment="CENTER" prefHeight="55.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 6px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="resolvedTodayLabel" text="0" textFill="#1e7e34">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Label text="Resolved Today" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- TABLE SECTION (EXPANDS DYNAMICALLY) -->
        <VBox spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 8px 10px;" VBox.vgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Active Crisis Cases" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="4.0">
                            <children>
                                <Label text="Total:" textFill="GRAY">
                                    <font><Font size="11.0" /></font>
                                </Label>
                                <Label fx:id="totalCasesCountHeaderLabel" text="8 Cases" textFill="#083c57">
                                    <font><Font name="System Bold" size="11.0" /></font>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <TableView fx:id="crisisTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="studentNameTableC" prefWidth="130.0" text="Student" />
                        <TableColumn fx:id="crisisTypeTableC" prefWidth="120.0" text="Crisis Type" />
                        <TableColumn fx:id="urgencyTableC" prefWidth="85.0" text="Urgency" />
                        <TableColumn fx:id="reportedDateTableC" prefWidth="110.0" text="Reported" />
                        <TableColumn fx:id="statusTableC" prefWidth="100.0" text="Status" />
                        <TableColumn fx:id="viewCaseButtonTableC" prefWidth="100.0" text="Action" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

    </children>
</VBox>
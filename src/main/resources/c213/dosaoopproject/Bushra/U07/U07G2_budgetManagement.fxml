<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="530.0" prefWidth="720.0" spacing="6.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.U07.controller.U07G2_budgetManagementController">
    <padding>
        <Insets bottom="8.0" left="12.0" right="12.0" top="8.0" />
    </padding>
    <children>
        <!-- Section 1 — Page Header -->
        <VBox spacing="1.0">
            <children>
                <Label fx:id="pageTitleLabel" text="Annual Club Budget Allocation" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Label fx:id="pageDescriptionLabel" text="Review recommended allocations before publishing the final DoSA club budget." textFill="#555555">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- Section 2 — Summary Cards (Event-2) -->
        <HBox spacing="8.0">
            <children>
                <!-- Card 1: Total DoSA Budget -->
                <VBox prefHeight="50.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-background-radius: 6;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="4.0" left="6.0" right="6.0" top="4.0" />
                    </padding>
                    <children>
                        <Label text="Total DoSA Budget" textFill="#777777">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                        <Label fx:id="totalDoSABudgetLabel" text="10,000,000 BDT" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Card 2: Allocated -->
                <VBox prefHeight="50.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-background-radius: 6;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="4.0" left="6.0" right="6.0" top="4.0" />
                    </padding>
                    <children>
                        <Label text="Allocated" textFill="#777777">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                        <Label fx:id="allocatedToClubsLabel" text="8,150,000 BDT" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Card 3: Remaining (Green indicator) -->
                <VBox prefHeight="50.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-background-radius: 6;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="4.0" left="6.0" right="6.0" top="4.0" />
                    </padding>
                    <children>
                        <Label text="Remaining" textFill="#777777">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                        <Label fx:id="remainingBudgetLabel" text="1,850,000 BDT" textFill="#2e7d32">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Card 4: Progress -->
                <VBox prefHeight="50.0" spacing="1.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-background-radius: 6;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="4.0" left="6.0" right="6.0" top="4.0" />
                    </padding>
                    <children>
                        <Label text="Progress" textFill="#777777">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                        <Label fx:id="budgetProgressLabel" text="81%" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <ProgressBar fx:id="budgetProgressProgressB" maxWidth="1.7976931348623157E308" prefHeight="8.0" progress="0.81" style="-fx-accent: #007bff;" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Section 3 — Budget Allocation Table (Event-3) -->
        <VBox spacing="2.0">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Club Budget Requests" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="totalClubsLabel" text="Total: 12 Clubs" textFill="#555555">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
                <TableView fx:id="clubBudgetsTableView" prefHeight="129.0" prefWidth="696.0">
                    <columns>
                        <TableColumn fx:id="clubNameTableC" prefWidth="180.0" text="Club Name" />
                        <TableColumn fx:id="requestedAdditionalTableC" prefWidth="120.0" text="Requested" />
                        <TableColumn fx:id="recommendedAmountTableC" prefWidth="120.0" text="Recommended" />
                        <TableColumn fx:id="finalAllocationTableC" prefWidth="120.0" text="Final Allocation" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

        <!-- Section 4 & 5 — Inline Adjustment Panel & Validation Warning (Event-4 & Event-5) -->
        <VBox fx:id="inlineAdjustmentVBox" managed="true" prefHeight="214.0" prefWidth="696.0" spacing="4.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-background-radius: 6;" visible="true">
            <padding>
                <Insets bottom="6.0" left="8.0" right="8.0" top="6.0" />
            </padding>
            <children>
                <!-- Title -->
                <Label text="Adjust Budget Allocation" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>

                <!-- Selected Club -->
                <HBox spacing="4.0">
                    <children>
                        <Label text="Selected Club:" textFill="#555555">
                            <font>
                                <Font name="System Bold" size="10.0" />
                            </font>
                        </Label>
                        <Label fx:id="selectedClubLabel" text="IUB CSE Society" textFill="#083c57">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <!-- New Allocation Field -->
                <VBox spacing="1.0">
                    <children>
                        <Label text="New Allocation (BDT)" textFill="#555555">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                        <TextField fx:id="newAllocationAmountTextF" maxWidth="200.0" prefHeight="24.0" promptText="Enter amount" />
                    </children>
                </VBox>

                <!-- Reason Field -->
                <VBox spacing="1.0">
                    <children>
                        <Label text="Reason" textFill="#555555">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                        <TextField fx:id="adjustmentReasonTextF" maxWidth="320.0" prefHeight="24.0" promptText="Enter reason for adjustment" />
                    </children>
                </VBox>

                <!-- Validation Warning -->
                <Label fx:id="budgetWarningLabel" text="⚠ Exceeds available budget." textFill="#8b0000">
                    <font>
                        <Font size="10.0" />
                    </font>
                </Label>

                <!-- Save Action Button -->
                <HBox alignment="CENTER">
                    <children>
                        <Button fx:id="saveAdjustmentButton" mnemonicParsing="false" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 4;" text="Save Adjustment">
                            <font>
                                <Font name="System Bold" size="10.0" />
                            </font>
                            <padding>
                                <Insets bottom="4.0" left="12.0" right="12.0" top="4.0" />
                            </padding>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Section 6 — Publish Final Budget (Event-7) -->
        <HBox alignment="CENTER">
            <children>
                <Button fx:id="publishFinalBudgetButton" mnemonicParsing="false" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-background-radius: 4;" text="Publish Final Budget">
                    <font>
                        <Font name="System Bold" size="11.0" />
                    </font>
                    <padding>
                        <Insets bottom="5.0" left="24.0" right="24.0" top="5.0" />
                    </padding>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>

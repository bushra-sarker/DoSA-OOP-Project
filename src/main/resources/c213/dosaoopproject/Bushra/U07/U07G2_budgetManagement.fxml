<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="530.0" prefWidth="720.0" spacing="10.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.U07.controller.U07G2_budgetManagementController">
    <padding>
        <Insets bottom="12.0" left="14.0" right="14.0" top="12.0" />
    </padding>
    <children>
        <!-- Page Header -->
        <VBox spacing="2.0">
            <children>
                <Label text="Annual Club Budget Allocation" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Label text="Review and finalize annual club budget allocations." textFill="#555555">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- Table Section -->
        <VBox spacing="6.0" VBox.vgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Club Budget Overview" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
                <TableView fx:id="budgetTableView" prefHeight="380.0" prefWidth="692.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="clubColumn" prefWidth="150.0" text="Club" />
                        <TableColumn fx:id="requestedColumn" prefWidth="120.0" text="Requested" />
                        <TableColumn fx:id="allocatedColumn" prefWidth="120.0" text="Allocated" />
                        <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Status" />
                        <TableColumn fx:id="remarksColumn" prefWidth="180.0" text="Remarks" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

        <!-- Action Bar -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="viewBudgetDetailButton" mnemonicParsing="false" onAction="#viewBudgetDetailOA" style="-fx-background-color: #083C57; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="View Allocation Details">
                    <font>
                        <Font name="System Bold" size="11.0" />
                    </font>
                    <padding>
                        <Insets bottom="6.0" left="16.0" right="16.0" top="6.0" />
                    </padding>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="550.0" prefWidth="690.0" spacing="12.0" style="-fx-background-color: #F4F6F9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.U07.controller.U07G1_EventDetailApprovalController">
    <padding>
        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
    </padding>
    <children>
        <Label text="Event Proposal Detail &amp; Decision" textFill="#083c57">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <!-- Warning Banner for Missing Attachments -->
        <Label fx:id="warningBannerLabel" prefHeight="30.0" prefWidth="650.0" style="-fx-background-color: #FFEBEE; -fx-text-fill: #C62828; -fx-border-color: #EF9A9A; -fx-border-radius: 4; -fx-background-radius: 4;" text=" ⚠️ Warning: Missing required documents (Proposal PDF / Budget Sheet)." visible="false">
            <padding>
                <Insets left="10.0" />
            </padding>
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>

        <!-- Event Summary Header -->
        <HBox spacing="20.0" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 5;">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label fx:id="eventNameLabel" text="Event: [Event Name]" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Label fx:id="clubNameLabel" text="Organizer: [Club Name]" textFill="#555555" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Budget Breakdown Table -->
        <Label text="Budget Breakdown" textFill="#083c57">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>
        <TableView fx:id="budgetTableView" prefHeight="130.0" prefWidth="650.0">
            <columns>
                <TableColumn fx:id="itemTableCC" prefWidth="300.0" text="Item Description" />
                <TableColumn fx:id="amountTableCC" prefWidth="180.0" text="Estimated Amount (BDT)" />
            </columns>
        </TableView>

        <!-- Decision Action Buttons -->
        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#approveOA" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold;" text="Approve" />
                <Button mnemonicParsing="false" onAction="#returnForRevisionOA" style="-fx-background-color: #F57C00; -fx-text-fill: white; -fx-font-weight: bold;" text="Return for Revision" />
                <Button mnemonicParsing="false" onAction="#rejectOA" style="-fx-background-color: #C62828; -fx-text-fill: white; -fx-font-weight: bold;" text="Reject" />
            </children>
        </HBox>

        <!-- Inline Panel: Revision -->
        <VBox fx:id="inlineRevisionVBox" managed="false" spacing="5.0" style="-fx-background-color: #FFF3E0; -fx-padding: 10; -fx-background-radius: 5;" visible="false">
            <children>
                <Label text="Revision Feedback (Max 500 characters):" textFill="#E65100">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
                <TextArea fx:id="revisionCommentsTextF" prefHeight="60.0" promptText="Enter feedback for revision..." wrapText="true" />
                <Button onAction="#submitRevisionOA" style="-fx-background-color: #E65100; -fx-text-fill: white;" text="Submit Revision Request" />
            </children>
        </VBox>

        <!-- Inline Panel: Rejection -->
        <VBox fx:id="inlineRejectVBox" managed="false" spacing="5.0" style="-fx-background-color: #FFEBEE; -fx-padding: 10; -fx-background-radius: 5;" visible="false">
            <children>
                <Label text="Rejection Reason (Min 20 characters):" textFill="#C62828">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
                <TextArea fx:id="rejectReasonTextF" prefHeight="60.0" promptText="Provide detailed reason for rejection..." wrapText="true" />
                <Button onAction="#submitRejectOA" style="-fx-background-color: #C62828; -fx-text-fill: white;" text="Confirm Rejection" />
            </children>
        </VBox>
    </children>
</VBox>

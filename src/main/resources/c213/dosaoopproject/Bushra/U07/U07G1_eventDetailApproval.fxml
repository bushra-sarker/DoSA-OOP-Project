<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="530.0" prefWidth="720.0" spacing="8.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.U07.controller.U07G1_eventDetailApprovalController">
    <padding>
        <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
    </padding>
    <children>

        <!-- WARNING BANNER -->
        <VBox fx:id="warningBannerVBox" managed="false" spacing="2.0" style="-fx-background-color: #F8D7DA; -fx-border-color: #F5C6CB; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 8px;" visible="false">
            <children>
                <Label style="-fx-text-fill: #721C24;" text="⚠ Missing Required Documents">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
                <Label fx:id="warningBannerLabel" style="-fx-text-fill: #721C24;" text="Proposal PDF and Budget Sheet are required before final approval.">
                    <font><Font size="10.0" /></font>
                </Label>
            </children>
        </VBox>

        <!-- PAGE HEADER -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #E0E0E0; -fx-padding: 8px 10px;">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button mnemonicParsing="false" onAction="#backOA" style="-fx-background-color: transparent; -fx-text-fill: #083C57; -fx-cursor: hand;" text="← Back to Queue">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Button>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="4.0" style="-fx-background-color: #FFF3CD; -fx-padding: 2 6 2 6; -fx-background-radius: 10; -fx-border-color: #FFEEBA; -fx-border-radius: 10;">
                            <children>
                                <Label text="Status:" textFill="#856404">
                                    <font><Font name="System Bold" size="10.0" /></font>
                                </Label>
                                <Label fx:id="statusLabel" text="Pending Review" textFill="#856404">
                                    <font><Font name="System Bold" size="10.0" /></font>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </HBox>
                <Label text="Review Major Event Proposal" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- EVENT DETAILS CARD -->
        <VBox spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #E0E0E0; -fx-padding: 8px 10px;">
            <children>
                <Label text="Event Information" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Label>
                <HBox spacing="10.0">
                    <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox>
                                    <children>
                                        <Label text="Event Name" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                        <Label fx:id="eventNameLabel" text="National Tech Fest" textFill="#083c57"><font><Font name="System Bold" size="12.0" /></font></Label>
                                    </children>
                                </VBox>
                                <VBox>
                                    <children>
                                        <Label text="Club Name" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                        <Label fx:id="clubNameLabel" text="IUB CSE Society"><font><Font size="11.0" /></font></Label>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox>
                                    <children>
                                        <Label text="Event Date" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                        <Label fx:id="eventDateLabel" text="15 August 2026"><font><Font size="11.0" /></font></Label>
                                    </children>
                                </VBox>
                                <VBox>
                                    <children>
                                        <Label text="Venue" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                        <Label fx:id="venueLabel" text="Auditorium"><font><Font size="11.0" /></font></Label>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox>
                                    <children>
                                        <Label text="Requested Budget" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                        <Label fx:id="requestedBudgetLabel" text="120,000 BDT" textFill="#083c57"><font><Font name="System Bold" size="12.0" /></font></Label>
                                    </children>
                                </VBox>
                                <VBox>
                                    <children>
                                        <Label text="Scope" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                        <Label fx:id="scopeLabel" text="Inter-University"><font><Font size="11.0" /></font></Label>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox>
                                    <children>
                                        <Label text="Risk Level" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                        <Label fx:id="riskLevelLabel" style="-fx-text-fill: #750000;" text="HIGH"><font><Font name="System Bold" size="12.0" /></font></Label>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- UPLOADED DOCUMENTS -->
        <VBox spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #E0E0E0; -fx-padding: 8px 10px;">
            <children>
                <Label text="Uploaded Documents" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Label>
                <HBox spacing="30.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <children>
                                <Label text="Proposal PDF:" textFill="GRAY"><font><Font size="11.0" /></font></Label>
                                <Label fx:id="proposalStatusLabel" text="✔ Uploaded" textFill="#1E7E34">
                                    <font><Font name="System Bold" size="11.0" /></font>
                                </Label>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <children>
                                <Label text="Budget Sheet:" textFill="GRAY"><font><Font size="11.0" /></font></Label>
                                <Label fx:id="budgetSheetStatusLabel" text="✔ Uploaded" textFill="#1E7E34">
                                    <font><Font name="System Bold" size="11.0" /></font>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- DECISION ACTION BUTTONS -->
        <HBox spacing="10.0">
            <children>
                <Button fx:id="approveButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#approveOA" prefHeight="32.0" style="-fx-background-color: #1E7E34; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="Approve" HBox.hgrow="ALWAYS">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Button>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#returnOA" prefHeight="32.0" style="-fx-background-color: #D39E00; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="Return for Revision" HBox.hgrow="ALWAYS">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Button>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#rejectOA" prefHeight="32.0" style="-fx-background-color: #BD2130; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="Reject" HBox.hgrow="ALWAYS">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Button>
            </children>
        </HBox>

        <!-- REVISION PANEL -->
        <VBox fx:id="inlineRevisionVBox" managed="false" spacing="6.0" style="-fx-background-color: #FFF8E1; -fx-border-color: #FFE082; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 8px;" visible="false">
            <children>
                <Label text="Revision Comments" textFill="#856404">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Label>
                <TextArea fx:id="revisionCommentsTextF" prefHeight="50.0" promptText="Enter required revisions..." wrapText="true" />
                <HBox alignment="CENTER_RIGHT">
                    <children>
                        <Button mnemonicParsing="false" onAction="#confirmRevisionOA" style="-fx-background-color: #D39E00; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;" text="Confirm Revision">
                            <font><Font name="System Bold" size="11.0" /></font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- REJECT PANEL -->
        <VBox fx:id="inlineRejectVBox" managed="false" spacing="6.0" style="-fx-background-color: #F8D7DA; -fx-border-color: #F5C6CB; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 8px;" visible="false">
            <children>
                <Label text="Reject Reason (Minimum 20 characters)" textFill="#721C24">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Label>
                <TextArea fx:id="rejectReasonTextF" prefHeight="50.0" promptText="Enter formal rejection justification..." wrapText="true" />
                <HBox alignment="CENTER_RIGHT">
                    <children>
                        <Button mnemonicParsing="false" onAction="#confirmRejectOA" style="-fx-background-color: #BD2130; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;" text="Confirm Reject">
                            <font><Font name="System Bold" size="11.0" /></font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>

    </children>
</VBox>
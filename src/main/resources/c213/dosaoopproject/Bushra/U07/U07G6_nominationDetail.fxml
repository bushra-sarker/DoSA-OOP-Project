<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="530.0" prefWidth="720.0" spacing="6.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.U07.controller.U07G6_nominationDetailController">
    <padding>
        <Insets bottom="8.0" left="12.0" right="12.0" top="8.0" />
    </padding>
    <children>

        <!-- PAGE HEADER CARD -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #E0E0E0; -fx-padding: 6px 10px;">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button mnemonicParsing="false" onAction="#backOA" style="-fx-background-color: transparent; -fx-text-fill: #083C57; -fx-cursor: hand;" text="← Back to Nominations">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Button>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="6.0" style="-fx-background-color: #FFF3CD; -fx-padding: 2 8 2 8; -fx-background-radius: 10; -fx-border-color: #FFEEBA; -fx-border-radius: 10;">
                            <children>
                                <Label text="Status:" textFill="#856404">
                                    <font><Font name="System Bold" size="10.0" /></font>
                                </Label>
                                <Label fx:id="statusBadgeLabel" text="Pending Review" textFill="#856404">
                                    <font><Font name="System Bold" size="10.0" /></font>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </HBox>
                <Label text="Review Exchange Nomination" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- STUDENT INFORMATION CARD -->
        <VBox spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #E0E0E0; -fx-padding: 6px 10px;">
            <children>
                <Label text="Student Information" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
                <HBox prefHeight="51.0" prefWidth="674.0" spacing="10.0">
                    <children>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Student Name" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                <Label fx:id="studentNameLabel" text="Rahim Ahmed" textFill="#083c57"><font><Font name="System Bold" size="11.0" /></font></Label>
                            </children>
                        </VBox>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Student ID" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                <Label fx:id="studentIDLabel" text="21201045"><font><Font size="11.0" /></font></Label>
                            </children>
                        </VBox>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Department" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                <Label fx:id="departmentLabel" text="CSE"><font><Font size="11.0" /></font></Label>
                            </children>
                        </VBox>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="CGPA" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                <Label fx:id="cgpaLabel" text="3.85" textFill="#083c57"><font><Font name="System Bold" size="11.0" /></font></Label>
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <HBox prefHeight="49.0" prefWidth="674.0" spacing="10.0" style="-fx-padding: 2 0 0 0;">
                    <children>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Host University" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                <Label fx:id="hostUniversityLabel" text="National University of Singapore"><font><Font size="11.0" /></font></Label>
                            </children>
                        </VBox>
                        <VBox prefWidth="179.0" spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Exchange Semester" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                <Label fx:id="exchangeSemesterLabel" text="Autumn 2026"><font><Font size="11.0" /></font></Label>
                            </children>
                        </VBox>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Program" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                <Label fx:id="programLabel" text="Global Academic Exchange"><font><Font size="11.0" /></font></Label>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- ELIGIBILITY VERIFICATION CARD -->
        <VBox prefHeight="153.0" prefWidth="696.0" spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #E0E0E0; -fx-padding: 6px 10px;">
            <children>
                <Label text="Eligibility Verification" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
                <HBox alignment="CENTER_LEFT" prefHeight="202.0" prefWidth="674.0" spacing="25.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="4.0">
                            <children>
                                <Label text="CGPA Requirement:" textFill="GRAY"><font><Font size="11.0" /></font></Label>
                                <Label fx:id="cgpaCheckLabel" text="✔ CGPA ≥ 3.00" textFill="#1E7E34"><font><Font name="System Bold" size="11.0" /></font></Label>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="4.0">
                            <children>
                                <Label text="Disciplinary Record:" textFill="GRAY"><font><Font size="11.0" /></font></Label>
                                <Label fx:id="disciplinaryCheckLabel" text="✔ No disciplinary record" textFill="#1E7E34"><font><Font name="System Bold" size="11.0" /></font></Label>
                            </children>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER_LEFT" spacing="4.0">
                            <children>
                                <Label text="Overall Status:" textFill="GRAY"><font><Font size="11.0" /></font></Label>
                                <Label fx:id="eligibilityStatusLabel" style="-fx-background-color: #D4EDDA; -fx-text-fill: #155724; -fx-padding: 2 6 2 6; -fx-background-radius: 4;" text="ELIGIBLE">
                                    <font><Font name="System Bold" size="11.0" /></font>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- DECISION ACTION BUTTONS -->
        <HBox spacing="10.0">
            <children>
                <Button fx:id="approveNominationButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#approveNominationOA" prefHeight="32.0" style="-fx-background-color: #1E7E34; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="Approve" HBox.hgrow="ALWAYS">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Button>
                <Button fx:id="requestInfoButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#requestInfoOA" prefHeight="32.0" style="-fx-background-color: #D39E00; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="Request Information" HBox.hgrow="ALWAYS">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Button>
                <Button fx:id="rejectNominationButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#rejectNominationOA" prefHeight="32.0" style="-fx-background-color: #BD2130; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="Reject" HBox.hgrow="ALWAYS">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Button>
            </children>
        </HBox>

        <!-- INLINE REASON PANEL (Initially Hidden) -->
        <VBox fx:id="inlineReasonVBox" managed="false" spacing="4.0" style="-fx-background-color: #FFF8E1; -fx-border-color: #FFE082; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 8px;" visible="false" VBox.vgrow="ALWAYS">
            <children>
                <Label fx:id="reasonHeaderLabel" text="Reason / Details (Minimum 15 characters)" textFill="#856404">
                    <font><Font name="System Bold" size="11.0" /></font>
                </Label>
                <TextArea fx:id="reasonTextF" prefHeight="45.0" promptText="Provide justification or specify missing information..." wrapText="true" VBox.vgrow="ALWAYS">
                    <font><Font size="11.0" /></font>
                </TextArea>
            </children>
        </VBox>

        <!-- CONFIRM DECISION BUTTON -->
        <HBox alignment="CENTER">
            <children>
                <Button fx:id="confirmDecisionButton" mnemonicParsing="false" onAction="#confirmDecisionOA" prefHeight="32.0" prefWidth="240.0" style="-fx-background-color: #083C57; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="Confirm Decision">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
            </children>
        </HBox>

    </children>
</VBox>

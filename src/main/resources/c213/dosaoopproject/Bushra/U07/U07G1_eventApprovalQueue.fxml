<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="695.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.U07.controller.U07G1_eventApprovalQueueController">
    <padding>
        <Insets bottom="15.0" left="12.0" right="12.0" top="15.0" />
    </padding>
    <children>

        <!-- HEADER BLOCK -->
        <VBox style="-fx-border-color: lightGray; -fx-background-radius: 8; -fx-border-radius: 8; -fx-background-color: white; -fx-padding: 12px;">
            <children>
                <Label text="Major Events Approval Queue" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Label text="Review, approve, or return high-value event proposals submitted by student clubs." textFill="GRAY">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- FILTERS & SEARCH BAR -->
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-border-color: lightgray; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 10px;">
            <children>
                <TextField fx:id="searchTextField" prefHeight="28.0" prefWidth="220.0" promptText="Search by event or club..." style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: lightgray;">
                    <font>
                        <Font size="12.0" />
                    </font>
                </TextField>
                <ComboBox fx:id="statusFilterComboBox" prefHeight="28.0" prefWidth="130.0" promptText="All Statuses" style="-fx-background-color: white; -fx-border-color: lightgray; -fx-border-radius: 5;" />
                <ComboBox fx:id="riskFilterComboBox" prefHeight="28.0" prefWidth="120.0" promptText="All Risks" style="-fx-background-color: white; -fx-border-color: lightgray; -fx-border-radius: 5;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="resetFiltersButton" mnemonicParsing="false" style="-fx-background-color: #f0f0f0; -fx-text-fill: #333; -fx-border-color: lightgray; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;" text="Reset">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Button>
            </children>
        </HBox>

        <!-- PROPOSALS TABLE CARD -->
        <VBox spacing="10.0" style="-fx-background-color: white; -fx-border-color: lightgray; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 12px;">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Event Proposals" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="totalCountLabel" text="Total: 0 items" textFill="GRAY">
                            <font>
                                <Font size="11.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
                <TableView fx:id="eventsTableView" prefHeight="300.0">
                    <columns>
                        <TableColumn fx:id="eventNameCol" prefWidth="160.0" text="Event Name" />
                        <TableColumn fx:id="clubNameCol" prefWidth="130.0" text="Club / Org" />
                        <TableColumn fx:id="eventDateCol" prefWidth="95.0" text="Date" />
                        <TableColumn fx:id="budgetCol" prefWidth="95.0" text="Budget (BDT)" />
                        <TableColumn fx:id="riskCol" prefWidth="75.0" text="Risk" />
                        <TableColumn fx:id="statusCol" prefWidth="110.0" text="Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- ACTION BAR BELOW TABLE -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button fx:id="viewDetailsButton" disable="true" mnemonicParsing="false" onAction="#handleViewDetails" prefHeight="32.0" prefWidth="130.0" style="-fx-background-color: #083C57; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="View Details">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>

    </children>
</VBox>
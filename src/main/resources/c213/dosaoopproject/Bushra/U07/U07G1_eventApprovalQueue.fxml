<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500.0" prefWidth="690.0" spacing="15.0" style="-fx-background-color: #F4F6F9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.U07.controller.U07G1_EventApprovalQueueController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Major Event Proposal Review Queue" textFill="#083c57">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <TableView fx:id="pendingMajorEventsTableView" prefHeight="380.0" prefWidth="650.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="eventNameTableCC" prefWidth="160.0" text="Event Name" />
                <TableColumn fx:id="clubNameTableCC" prefWidth="140.0" text="Club Name" />
                <TableColumn fx:id="requestedBudgetTableCC" prefWidth="130.0" text="Budget (BDT)" />
                <TableColumn fx:id="eventDateTableCC" prefWidth="110.0" text="Event Date" />
                <TableColumn fx:id="riskLevelTableCC" prefWidth="110.0" text="Risk Level" />
            </columns>
        </TableView>

        <HBox alignment="CENTER_RIGHT">
            <children>
                <Button mnemonicParsing="false" onAction="#viewDetailsOA" style="-fx-background-color: #004675; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="View Details">
                    <padding>
                        <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
                    </padding>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>

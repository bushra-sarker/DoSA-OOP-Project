<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="530.0" prefWidth="720.0" spacing="8.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.U07.controller.U07G3_appealsListController">
    <padding>
        <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
    </padding>
    <children>

        <!-- HEADER SECTION -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 8px 10px;">
            <children>
                <Label text="Handle Student Disciplinary Appeals" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Label text="Review and process submitted disciplinary appeals." textFill="GRAY">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- SUMMARY CARDS SECTION (4 Cards Grid) -->
        <HBox spacing="8.0">
            <children>
                <!-- Card 1 -->
                <VBox alignment="CENTER" prefHeight="55.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 6px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="pendingAppealsLabel" text="0" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Label text="Pending Appeals" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Card 2 -->
                <VBox alignment="CENTER" prefHeight="55.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 6px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="lateSubmissionCountLabel" text="0" textFill="#bd2130">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Label text="Late Submissions" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Card 3 -->
                <VBox alignment="CENTER" prefHeight="55.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 6px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="reviewedTodayLabel" text="0" textFill="#1e7e34">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Label text="Reviewed Today" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Card 4 -->
                <VBox alignment="CENTER" prefHeight="55.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 6px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="totalAppealsLabel" text="0" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Label text="Total Appeals" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- TABLE SECTION -->
        <VBox spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 8px 10px;" VBox.vgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Student Appeals" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="4.0">
                            <children>
                                <Label text="Total:" textFill="GRAY">
                                    <font><Font size="11.0" /></font>
                                </Label>
                                <Label fx:id="totalCountHeaderLabel" text="0" textFill="#083c57">
                                    <font><Font name="System Bold" size="11.0" /></font>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <TableView fx:id="appealsTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="appealIdTableC" prefWidth="85.0" text="Appeal ID" />
                        <TableColumn fx:id="studentIDTableC" prefWidth="95.0" text="Student ID" />
                        <TableColumn fx:id="offenseTypeTableC" prefWidth="130.0" text="Offense" />
                        <TableColumn fx:id="originalPenaltyTableC" prefWidth="120.0" text="Penalty" />
                        <TableColumn fx:id="submissionDateTableC" prefWidth="110.0" text="Submission Date" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- ACTION BUTTON (Added to meet Event 5) -->
                <HBox alignment="CENTER_RIGHT" style="-fx-padding: 4 0 0 0;">
                    <children>
                        <Button fx:id="viewAppealButton" mnemonicParsing="false" onAction="#viewAppealOA" style="-fx-background-color: #083C57; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 6;" text="View Selected Appeal Details">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>

    </children>
</VBox>
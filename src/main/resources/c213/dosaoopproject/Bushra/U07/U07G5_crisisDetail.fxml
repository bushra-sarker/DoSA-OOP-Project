<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="530.0" prefWidth="720.0" spacing="8.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.U07.controller.U07G5_CrisisDetailController">
    <padding>
        <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
    </padding>
    <children>

        <!-- PAGE HEADER -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #E0E0E0; -fx-padding: 8px 10px;">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: transparent; -fx-text-fill: #083C57; -fx-cursor: hand;" text="← Back to Queue">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Button>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="4.0" style="-fx-background-color: #FFF3CD; -fx-padding: 2 6 2 6; -fx-background-radius: 10; -fx-border-color: #FFEEBA; -fx-border-radius: 10;">
                            <children>
                                <Label text="Status:" textFill="#856404">
                                    <font><Font name="System Bold" size="10.0" /></font>
                                </Label>
                                <Label fx:id="statusLabel" text="OPEN" textFill="#856404">
                                    <font><Font name="System Bold" size="10.0" /></font>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </HBox>
                <Label text="Crisis Case Details &amp; Resolution" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- CASE INFORMATION CARD -->
        <VBox spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #E0E0E0; -fx-padding: 8px 10px;">
            <children>
                <Label text="Case Overview" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Label>
                <HBox spacing="10.0">
                    <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox>
                                    <children>
                                        <Label text="Case ID" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                        <Label fx:id="lblCaseId" text="CRS-2026-001" textFill="#083c57"><font><Font name="System Bold" size="12.0" /></font></Label>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox>
                                    <children>
                                        <Label text="Student ID" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                        <Label fx:id="lblStudentId" text="21301042"><font><Font size="11.0" /></font></Label>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox>
                                    <children>
                                        <Label text="Urgency Level" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                        <Label fx:id="lblUrgency" style="-fx-text-fill: #BD2130;" text="CRITICAL"><font><Font name="System Bold" size="12.0" /></font></Label>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- INTERVENTION EDIT CARD -->
        <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #E0E0E0; -fx-padding: 8px 10px;">
            <children>
                <Label text="Intervention Action &amp; Logs" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Label>
                <VBox spacing="2.0">
                    <children>
                        <Label text="Assigned Response Team" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                        <TextField fx:id="txtResponseTeam" promptText="e.g. Medical &amp; Counseling Unit A" />
                    </children>
                </VBox>
                <VBox spacing="2.0">
                    <children>
                        <Label text="Intervention Log Notes" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                        <TextArea fx:id="txtInterventionLog" prefHeight="90.0" promptText="Enter detailed intervention notes and outcome..." wrapText="true" />
                    </children>
                </VBox>
            </children>
        </VBox>

              <!-- ACTION BUTTONS -->
        <HBox spacing="10.0">
         <children>
                <Button fx:id="markResolvedButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleMarkResolved" prefHeight="25.0" prefWidth="280.0" style="-fx-background-color: #1E7E34; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="Mark Resolved &amp; Save">
                    <font>
                  <Font name="System Bold" size="12.0" />
               </font>
                </Button>
         </children>
        </HBox>

    </children>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="530.0" prefWidth="720.0" spacing="8.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.U08.controller.U08G1_scholarshipManagementController">
    <padding>
        <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
    </padding>
    <children>

        <!-- HEADER CARD -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 8px 10px;">
            <children>
                <Label text="Process Student Scholarship Applications" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Label text="Review and evaluate pending scholarship requests." textFill="GRAY">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- SUMMARY CARDS SECTION -->
        <HBox spacing="8.0">
            <children>
                <!-- Card 1 -->
                <VBox alignment="CENTER" prefHeight="50.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 4px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="pendingApplicationsCountLabel" text="0" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>
                        <Label text="Pending Applications" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Card 2 -->
                <VBox alignment="CENTER" prefHeight="50.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 4px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="eligibleApplicationsCountLabel" text="0" textFill="#1e7e34">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>
                        <Label text="Eligible" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Card 3 -->
                <VBox alignment="CENTER" prefHeight="50.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 4px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="needReviewCountLabel" text="0" textFill="#d39e00">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>
                        <Label text="Need Review" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Card 4 -->
                <VBox alignment="CENTER" prefHeight="50.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 4px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="rejectedApplicationsCountLabel" text="0" textFill="#bd2130">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>
                        <Label text="Rejected" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- TABLE CARD -->
        <VBox spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 8px 10px;" VBox.vgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Scholarship Applications" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <TableView fx:id="pendingApplicationsTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="applicationIdTableC" prefWidth="85.0" text="App ID" />
                        <TableColumn fx:id="studentIdTableC" prefWidth="90.0" text="Student ID" />
                        <TableColumn fx:id="studentNameTableC" prefWidth="120.0" text="Student Name" />
                        <TableColumn fx:id="scholarshipSchemeTableC" prefWidth="130.0" text="Scheme" />
                        <TableColumn fx:id="cgpaTableC" prefWidth="65.0" text="CGPA" />
                        <TableColumn fx:id="monthlyFamilyIncomeTableC" prefWidth="100.0" text="Income (BDT)" />
                        <TableColumn fx:id="applicationStatusTableC" prefWidth="85.0" text="Status" />
                        <TableColumn fx:id="reviewButtonTableC" prefWidth="75.0" text="Action" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

    </children>
</VBox>

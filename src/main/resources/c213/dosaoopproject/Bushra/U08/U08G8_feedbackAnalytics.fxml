<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="530.0" prefWidth="720.0" spacing="8.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.U08.controller.U08G8FeedbackAnalyticsController">
    <padding>
        <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
    </padding>
    <children>

        <!-- HEADER CARD -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 8px 10px;">
            <children>
                <Label text="Student Feedback Analytics" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Label text="Analyze student feedback and manage campus satisfaction surveys." textFill="GRAY">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- SUMMARY CARDS SECTION (4 CARDS) -->
        <HBox spacing="8.0">
            <children>
                <!-- Active Surveys Card -->
                <VBox alignment="CENTER" prefHeight="50.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 4px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="activeSurveysLabel" text="0" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>
                        <Label text="Active Surveys" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Total Responses Card -->
                <VBox alignment="CENTER" prefHeight="50.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 4px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="totalResponsesLabel" text="0" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>
                        <Label text="Total Responses" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Avg Rating Card -->
                <VBox alignment="CENTER" prefHeight="50.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 4px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="averageRatingLabel" text="0.0" textFill="#1e7e34">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>
                        <Label text="Avg. Rating" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Action Reports Card -->
                <VBox alignment="CENTER" prefHeight="50.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 4px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="actionReportsLabel" text="0" textFill="#d39e00">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>
                        <Label text="Action Reports" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- ANALYTICS SECTION (SPLIT LAYOUT: BAR CHART + TABLE) -->
        <HBox spacing="8.0" VBox.vgrow="ALWAYS">
            <children>
                <!-- BAR CHART CARD (LEFT SIDE) -->
                <VBox prefWidth="270.0" spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 8px 6px;">
                    <children>
                        <Label text="Satisfaction Ratings" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <BarChart fx:id="satisfactionBarChart" animated="false" legendVisible="false" prefHeight="200.0" VBox.vgrow="ALWAYS">
                            <xAxis>
                                <CategoryAxis side="BOTTOM" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis side="LEFT" />
                            </yAxis>
                        </BarChart>
                    </children>
                </VBox>

                <!-- TABLE & ACTIONS CARD (RIGHT SIDE) -->
                <VBox spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 8px 10px;" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Survey Performance Metrics" textFill="#083c57">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>

                        <TableView fx:id="feedbackMetricsTableView" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="surveyTitleTableC" prefWidth="110.0" text="Survey Title" />
                                <TableColumn fx:id="targetDepartmentTableC" prefWidth="85.0" text="Department" />
                                <TableColumn fx:id="totalResponsesTableC" prefWidth="65.0" text="Responses" />
                                <TableColumn fx:id="averageRatingTableC" prefWidth="60.0" text="Avg. Rating" />
                                <TableColumn fx:id="sentimentScoreTableC" prefWidth="65.0" text="Sentiment" />
                                <TableColumn fx:id="statusTableC" prefWidth="60.0" text="Status" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <!-- BOTTOM BUTTONS -->
                        <HBox alignment="CENTER_RIGHT" spacing="8.0">
                            <children>
                                <Button fx:id="createNewSurveyButton" mnemonicParsing="false" onAction="#createNewSurveyOA" prefHeight="26.0" prefWidth="140.0" style="-fx-background-color: #083C57; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;" text="Create New Survey">
                                    <font>
                                        <Font name="System Bold" size="10.0" />
                                    </font>
                                </Button>
                                <Button fx:id="generateActionReportButton" mnemonicParsing="false" onAction="#generateActionReportOA" prefHeight="26.0" prefWidth="150.0" style="-fx-background-color: #1E7E34; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;" text="Generate Action Report">
                                    <font>
                                        <Font name="System Bold" size="10.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>

    </children>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="530.0" prefWidth="720.0" spacing="6.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.U08.controller.U08G2_requestDetailController">
    <padding>
        <Insets bottom="8.0" left="12.0" right="12.0" top="8.0" />
    </padding>
    <children>

        <!-- PAGE HEADER CARD -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #E0E0E0; -fx-padding: 6px 10px;">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button mnemonicParsing="false" onAction="#backOA" style="-fx-background-color: transparent; -fx-text-fill: #083C57; -fx-cursor: hand;" text="← Back to Emergency Requests">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
                <Label text="Emergency Financial Assistance Review" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- STUDENT PROFILE & STATEMENT ROW -->
        <HBox spacing="8.0">
            <children>
                <!-- Student Info Card -->
                <VBox spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #E0E0E0; -fx-padding: 6px 10px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Student Information" textFill="#083c57">
                            <font><Font name="System Bold" size="11.0" /></font>
                        </Label>
                        <HBox spacing="10.0">
                            <children>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label text="Name:" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                        <Label text="ID:" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                        <Label text="Dept:" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                        <Label text="Category:" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                        <Label text="Requested:" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                    </children>
                                </VBox>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label fx:id="studentNameLabel" text="--" textFill="#333333"><font><Font name="System Bold" size="10.0" /></font></Label>
                                        <Label fx:id="studentIdLabel" text="--" textFill="#333333"><font><Font name="System Bold" size="10.0" /></font></Label>
                                        <Label fx:id="departmentLabel" text="--" textFill="#333333"><font><Font name="System Bold" size="10.0" /></font></Label>
                                        <Label fx:id="emergencyCategoryLabel" text="--" textFill="#083c57"><font><Font name="System Bold" size="10.0" /></font></Label>
                                        <Label fx:id="requestedAmountLabel" text="BDT 0" textFill="#1e7e34"><font><Font name="System Bold" size="10.0" /></font></Label>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Emergency Statement Card -->
                <VBox spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #E0E0E0; -fx-padding: 6px 10px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Emergency Statement" textFill="#083c57">
                            <font><Font name="System Bold" size="11.0" /></font>
                        </Label>
                        <TextArea fx:id="emergencyStatementTextArea" editable="false" prefHeight="65.0" promptText="Student statement..." wrapText="true">
                            <font><Font size="10.0" /></font>
                        </TextArea>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- DOCUMENTS & VERIFICATION ROW -->
        <HBox spacing="8.0">
            <children>
                <!-- Supporting Documents List Card -->
                <VBox spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #E0E0E0; -fx-padding: 6px 10px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Supporting Documents" textFill="#083c57">
                            <font><Font name="System Bold" size="11.0" /></font>
                        </Label>
                        <ListView fx:id="attachedDocsListV" prefHeight="55.0" />
                    </children>
                </VBox>

                <!-- Verification Status Card -->
                <VBox spacing="3.0" style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #E0E0E0; -fx-padding: 6px 10px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Verification Status" textFill="#083c57">
                            <font><Font name="System Bold" size="11.0" /></font>
                        </Label>
                        <HBox spacing="8.0">
                            <children>
                                <Label text="Proof Docs:" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                <Label fx:id="proofStatusLabel" text="✔ Attached" textFill="#1E7E34"><font><Font name="System Bold" size="10.0" /></font></Label>
                            </children>
                        </HBox>
                        <HBox spacing="8.0">
                            <children>
                                <Label text="Dept Verify:" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                <Label fx:id="departmentVerificationLabel" text="Pending" textFill="#D39E00"><font><Font name="System Bold" size="10.0" /></font></Label>
                            </children>
                        </HBox>
                        <Label fx:id="missingDocWarningLabel" text="⚠ No supporting document attached." textFill="#BD2130" visible="false" managed="false">
                            <font><Font name="System Bold" size="10.0" /></font>
                        </Label>
                    </children>
                </VBox>

                <!-- Department Verification Action Card -->
                <VBox spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #E0E0E0; -fx-padding: 6px 10px;">
                    <children>
                        <Label text="Department Verification" textFill="#083c57">
                            <font><Font name="System Bold" size="11.0" /></font>
                        </Label>
                        <HBox spacing="6.0">
                            <children>
                                <Label text="Status:" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                <Label fx:id="deptVerificationStatusLabel" text="Pending" textFill="#D39E00"><font><Font name="System Bold" size="10.0" /></font></Label>
                            </children>
                        </HBox>
                        <Button fx:id="verifyDeptButton" mnemonicParsing="false" onAction="#verifyDeptOA" style="-fx-background-color: #083C57; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;" text="Verify Department">
                            <font><Font name="System Bold" size="10.0" /></font>
                        </Button>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- PAYMENT PROCESSING CARD -->
        <VBox spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #E0E0E0; -fx-padding: 6px 10px;">
            <children>
                <Label text="Payment Processing" textFill="#083c57">
                    <font><Font name="System Bold" size="11.0" /></font>
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Label text="Payment Method:" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                        <RadioButton fx:id="bankTransferRadio" mnemonicParsing="false" selected="true" text="Bank Transfer" textFill="#083c57">
                            <font><Font size="10.0" /></font>
                            <toggleGroup>
                                <ToggleGroup fx:id="paymentMethodGroup" />
                            </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="cashDisbursementRadio" mnemonicParsing="false" text="Cash Disbursement" textFill="#083c57" toggleGroup="$paymentMethodGroup">
                            <font><Font size="10.0" /></font>
                        </RadioButton>
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Account Number / BKash" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                <TextField fx:id="accountNumberTextF" promptText="Enter account or wallet number" style="-fx-font-size: 11px;" />
                            </children>
                        </VBox>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Approved Amount (BDT)" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                <TextField fx:id="approvedAmountTextF" promptText="Enter approved amount" style="-fx-font-size: 11px;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- FUND VALIDATION CARD -->
        <VBox spacing="3.0" style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #E0E0E0; -fx-padding: 6px 10px;">
            <children>
                <Label text="Fund Validation" textFill="#083c57">
                    <font><Font name="System Bold" size="11.0" /></font>
                </Label>
                <HBox spacing="15.0">
                    <children>
                        <HBox spacing="4.0">
                            <children>
                                <Label text="Available Balance:" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                <Label fx:id="availableFundBalanceLabel" text="BDT 250,000" textFill="#1E7E34"><font><Font name="System Bold" size="10.0" /></font></Label>
                            </children>
                        </HBox>
                        <HBox spacing="4.0">
                            <children>
                                <Label text="Validation Result:" textFill="GRAY"><font><Font size="10.0" /></font></Label>
                                <Label fx:id="validationStatusLabel" text="✔ Valid" textFill="#1E7E34"><font><Font name="System Bold" size="10.0" /></font></Label>
                            </children>
                        </HBox>
                    </children>
                </HBox>
                <Label fx:id="exceedsBalanceWarningLabel" text="⚠ Approved amount exceeds available balance." textFill="#BD2130" visible="false" managed="false">
                    <font><Font name="System Bold" size="10.0" /></font>
                </Label>
            </children>
        </VBox>

        <!-- BOTTOM ACTION BUTTON -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #E0E0E0; -fx-padding: 6px 10px;">
            <children>
                <HBox alignment="CENTER">
                    <children>
                        <Button fx:id="approveDisbursementButton" disable="true" mnemonicParsing="false" onAction="#approveDisbursementOA" prefHeight="30.0" prefWidth="220.0" style="-fx-background-color: #1E7E34; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;" text="Approve &amp; Process Disbursement">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>

    </children>
</VBox>
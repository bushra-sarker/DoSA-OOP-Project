<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="530.0" prefWidth="720.0" spacing="8.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.U08.controller.U08G6_HousingDashboardController">
    <padding>
        <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
    </padding>
    <children>

        <!-- HEADER CARD -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 8px 10px;">
            <children>
                <Label text="Student Housing &amp; Accommodation" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Label text="Manage hostel applications and room allocations." textFill="GRAY">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- WAITING LIST TABLE CARD -->
        <VBox spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 8px 10px;" VBox.vgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Housing Waiting List" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <TableView fx:id="waitingListTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="requestIdTableC" prefWidth="80.0" text="Request ID" />
                        <TableColumn fx:id="studentIdTableC" prefWidth="90.0" text="Student ID" />
                        <TableColumn fx:id="studentNameTableC" prefWidth="120.0" text="Student Name" />
                        <TableColumn fx:id="genderTableC" prefWidth="75.0" text="Gender" />
                        <TableColumn fx:id="applicationDateTableC" prefWidth="100.0" text="Application Date" />
                        <TableColumn fx:id="urgencyPriorityTableC" prefWidth="100.0" text="Urgency Priority" />
                        <TableColumn fx:id="applicationStatusTableC" prefWidth="90.0" text="Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- BOTTOM RIGHT ACTION -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button fx:id="allocateRoomButton" mnemonicParsing="false" onAction="#allocateRoomOA" prefHeight="28.0" prefWidth="150.0" style="-fx-background-color: #083C57; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;" text="Allocate Room">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>

    </children>
</VBox>

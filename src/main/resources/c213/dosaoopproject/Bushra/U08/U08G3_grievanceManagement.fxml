<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="530.0" prefWidth="720.0" spacing="8.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.U08.controller.U08G3_GrievanceManagementController">
    <padding>
        <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
    </padding>

    <children>
        <!-- HEADER CARD -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 8px 10px;">
            <children>
                <Label text="Student Grievance Redressal System" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Label text="Review and manage submitted student grievances" textFill="GRAY">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- SUMMARY CARDS -->
        <HBox spacing="8.0">
            <children>
                <VBox alignment="CENTER" prefHeight="50.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 4px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="academicGrievanceCountLabel" text="0" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>
                        <Label text="Academic Grievances" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <VBox alignment="CENTER" prefHeight="50.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 4px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="facilityGrievanceCountLabel" text="0" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>
                        <Label text="Facility Grievances" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <VBox alignment="CENTER" prefHeight="50.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 4px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="openGrievanceCountLabel" text="0" textFill="#d39e00">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>
                        <Label text="Open" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <VBox alignment="CENTER" prefHeight="50.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 4px;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="closedGrievanceCountLabel" text="0" textFill="#1e7e34">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>
                        <Label text="Closed" textFill="GRAY">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- ACADEMIC TABLE -->
        <VBox prefHeight="318.0" prefWidth="696.0" spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 6px 10px;" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Academic Grievances" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
                <TableView fx:id="academicGrievancesTableView" prefWidth="673.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="academicGrievanceIdTableC" prefWidth="80.0" text="Grievance ID" />
                        <TableColumn fx:id="academicCategoryTableC" prefWidth="110.0" text="Category" />
                        <TableColumn fx:id="academicGrievanceStatusTableC" prefWidth="80.0" text="Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

        <!-- FACILITY TABLE -->
        <VBox spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 6px 10px;" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Facility Grievances" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
                <TableView fx:id="facilityGrievancesTableView" prefHeight="258.0" prefWidth="673.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="facilityGrievanceIdTableC" prefWidth="80.0" text="Grievance ID" />
                        <TableColumn fx:id="facilityCategoryTableC" prefWidth="110.0" text="Category" />
                        <TableColumn fx:id="facilityGrievanceStatusTableC" prefWidth="80.0" text="Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            <Region prefHeight="29.0" prefWidth="673.0" />
            <Button mnemonicParsing="false" onAction="#openGrievanceOA" prefHeight="25.0" prefWidth="209.0" text="Open Grievance" />
            </children>
        </VBox>
    </children>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="530.0" prefWidth="720.0" spacing="8.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.U08.controller.U08G5OrientationOverviewController">
    <padding>
        <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
    </padding>
    <children>

        <!-- HEADER CARD -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 8px 10px;">
            <children>
                <Label text="Student Orientation &amp; Integration Programs" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Label text="Manage and organize university orientation programs for new student cohorts" textFill="GRAY">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- SEARCH, FILTER & TOP ACTION ROW -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #E0E0E0; -fx-padding: 6px 10px;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <TextField fx:id="searchProgramTextF" prefWidth="180.0" promptText="Search Semester / Venue..." style="-fx-font-size: 11px;" />
                        <ComboBox fx:id="statusFilterComboBox" prefWidth="130.0" promptText="Status" style="-fx-font-size: 11px;">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="All Statuses" />
                                    <String fx:value="Scheduled" />
                                    <String fx:value="Ongoing" />
                                    <String fx:value="Completed" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                        <Button fx:id="resetFilterButton" mnemonicParsing="false" onAction="#resetFilterOA" style="-fx-background-color: #6C757D; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;" text="Reset">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Button>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="createNewProgramButton" mnemonicParsing="false" onAction="#createNewProgramOA" prefHeight="28.0" style="-fx-background-color: #083C57; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;" text="+ Setup New Orientation">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- TABLE CARD -->
        <VBox spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-padding: 8px 10px;" VBox.vgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Scheduled Orientation Programs" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <TableView fx:id="orientationsTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="programIdTableC" prefWidth="80.0" text="Program ID" />
                        <TableColumn fx:id="semesterTableC" prefWidth="100.0" text="Semester" />
                        <TableColumn fx:id="startDateTableC" prefWidth="95.0" text="Start Date" />
                        <TableColumn fx:id="endDateTableC" prefWidth="95.0" text="End Date" />
                        <TableColumn fx:id="venueTableC" prefWidth="130.0" text="Venue" />
                        <TableColumn fx:id="targetCohortTableC" prefWidth="100.0" text="Target Cohort" />
                        <TableColumn fx:id="programStatusTableC" prefWidth="90.0" text="Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

    </children>
</VBox>
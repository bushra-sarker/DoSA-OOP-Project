<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="550.0" prefWidth="880.0" spacing="15.0" style="-fx-background-color: #F4F6F8;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.Controller.U07.U07G1_EventApprovalQueueController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <!-- Header Banner -->
        <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="840.0">
            <children>
                <VBox>
                    <children>
                        <Label text="Major Event Approval Queue" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <Label text="Reviewing events with budget &gt; 50,000 BDT or Inter-University Scope" textFill="#555555">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <!-- Main Events Table View (Event 4) -->
        <TableView fx:id="pendingMajorEventsTableV" prefHeight="420.0" prefWidth="840.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="eventNameTableCC" prefWidth="220.0" text="Event Name" />
                <TableColumn fx:id="clubNameTableCC" prefWidth="180.0" text="Club / Organization" />
                <TableColumn fx:id="requestedBudgetTableCC" prefWidth="140.0" text="Requested Budget (BDT)" />
                <TableColumn fx:id="eventDateTableCC" prefWidth="120.0" text="Event Date" />
                <TableColumn fx:id="riskLevelTableCC" prefWidth="160.0" text="Risk Level" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Actions Bar -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#viewDetailsButton" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: #36649B; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold;" text="View Details" />
            </children>
        </HBox>
    </children>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="420.0" prefWidth="520.0" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #004975; -fx-border-width: 2;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.Controller.U07.U07G2_BudgetAdjustmentDialogController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <!-- Modal Title -->
        <Label text="Adjust Club Budget Allocation" textFill="#083c57">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <!-- Proposed Events & Past Performance Info Card -->
        <VBox spacing="4.0" style="-fx-background-color: #F8F9FA; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #E0E0E0;">
            <children>
                <Label fx:id="selectedClubNameLabel" style="-fx-font-weight: bold;" text="Club: Robotics Club" textFill="#083c57" />
                <Label fx:id="proposedEventsLabel" text="Proposed Events Count: 5 events planned" textFill="#555555" />
                <Label fx:id="pastEfficiencyLabel" text="Past Spending Efficiency: 92%" textFill="#555555" />
            </children>
        </VBox>

        <!-- New Allocation Amount Input -->
        <VBox spacing="4.0">
            <children>
                <Label style="-fx-font-weight: bold;" text="New Allocation Amount (BDT):" textFill="#083c57" />
                <TextField fx:id="newAllocationAmountTextF" prefHeight="35.0" promptText="e.g. 75000" />
            </children>
        </VBox>

        <!-- Real-time Budget Limit Warning Label (Event 5) -->
        <Label fx:id="budgetWarningLabel" text="⚠️ Exceeds total remaining DoSA budget limit!" textFill="#D32F2F" visible="false" wrapText="true">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>

        <!-- Reason Input Area -->
        <VBox spacing="4.0" VBox.vgrow="ALWAYS">
            <children>
                <Label style="-fx-font-weight: bold;" text="Reason / Justification for Adjustment (Max 200 chars):" textFill="#083c57" />
                <TextArea fx:id="reasonTextF" prefHeight="90.0" promptText="Provide justification for increasing/decreasing allocation..." wrapText="true" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>

        <!-- Dialog Buttons -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#cancelButton" prefHeight="32.0" prefWidth="90.0" style="-fx-background-color: #757575; -fx-text-fill: white; -fx-background-radius: 5;" text="Cancel" />
                <Button fx:id="saveButton" mnemonicParsing="false" onAction="#saveButton" prefHeight="32.0" prefWidth="110.0" style="-fx-background-color: #388E3C; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;" text="Save" />
            </children>
        </HBox>
    </children>
</VBox>
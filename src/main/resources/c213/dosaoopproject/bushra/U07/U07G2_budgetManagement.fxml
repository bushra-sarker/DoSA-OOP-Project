<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="580.0" prefWidth="880.0" spacing="20.0" style="-fx-background-color: #F4F6F8;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.Controller.U07.U07G2_BudgetManagementController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>
    <children>
        <!-- Header Banner -->
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label text="Annual Club Budget Management" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                        <Label text="Overview of DoSA fiscal budget distribution and allocation status" textFill="#555555">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#publishFinalButton" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #388E3C; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold;" text="Publish Final Budget" />
            </children>
        </HBox>

        <!-- Summary Cards Grid -->
        <HBox spacing="15.0">
            <children>
                <!-- Total Budget Card -->
                <VBox prefHeight="100.0" prefWidth="270.0" spacing="8.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;">
                    <children>
                        <Label text="Total DoSA Budget" textFill="#777777">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                        <Label fx:id="totalDoSABudgetLabel" text="0.00 BDT" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Allocated Budget Card -->
                <VBox prefHeight="100.0" prefWidth="270.0" spacing="8.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;">
                    <children>
                        <Label text="Allocated to Clubs" textFill="#777777">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                        <Label fx:id="allocatedToClubsLabel" text="0.00 BDT" textFill="#36649b">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Remaining Budget Card -->
                <VBox prefHeight="100.0" prefWidth="270.0" spacing="8.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;">
                    <children>
                        <Label text="Remaining Budget" textFill="#777777">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                        <Label fx:id="remainingBudgetLabel" text="0.00 BDT" textFill="#388e3c">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Budget Allocation Progress Card -->
        <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;">
            <children>
                <Label text="Budget Allocation Utilization" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <ProgressBar fx:id="budgetProgressProgressB" prefHeight="22.0" prefWidth="800.0" progress="0.0" style="-fx-accent: #004975;" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>

        <Region VBox.vgrow="ALWAYS" />

        <!-- Navigation Action -->
        <HBox alignment="CENTER_RIGHT">
            <children>
                <Button mnemonicParsing="false" onAction="#clubAllocationButton" prefHeight="42.0" prefWidth="240.0" style="-fx-background-color: #004975; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold;" text="Manage Club Allocations →" />
            </children>
        </HBox>
    </children>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="580.0" prefWidth="880.0" spacing="15.0" style="-fx-background-color: #F4F6F8;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.Controller.U07.U07G1_ScholarshipFinalReviewController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#backToScholarshipQueueButton" style="-fx-background-color: #004975; -fx-text-fill: white; -fx-background-radius: 5;" text="← Back" />
                <Label text="Final Scholarship Review" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
            </children>
        </HBox>

        <!-- Student & Eligibility Overview Cards -->
        <HBox spacing="15.0">
            <children>
                <VBox prefWidth="410.0" spacing="8.0" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #E0E0E0;">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Student Profile" textFill="#083c57" />
                        <Label fx:id="studentNameLabel" text="Name: " />
                        <Label fx:id="studentIdLabel" text="Student ID: " />
                        <Label fx:id="deptLabel" text="Department: " />
                        <Label fx:id="cgpaLabel" text="CGPA: " />
                    </children>
                </VBox>
                <VBox prefWidth="415.0" spacing="8.0" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #E0E0E0;">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Eligibility Breakdown" textFill="#083c57" />
                        <Label fx:id="scholarshipTypeLabel" text="Type: Merit-Based Financial Aid" />
                        <Label fx:id="financialScoreLabel" text="Financial Need Score: 85/100" />
                        <Label fx:id="extraCurricularScoreLabel" text="Co-Curricular Score: 90/100" />
                        <Label fx:id="finalEligibilityScoreLabel" style="-fx-font-weight: bold;" text="Overall Score: 88.5" textFill="#388e3c" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Welfare Officer's Assessment Notes -->
        <VBox prefHeight="150.0" spacing="5.0" VBox.vgrow="ALWAYS">
            <children>
                <Label style="-fx-font-weight: bold;" text="Welfare Officer Recommendation Notes" textFill="#083c57" />
                <TextArea fx:id="welfareNotesTextA" editable="false" prefHeight="130.0" prefWidth="840.0" style="-fx-background-color: white;" wrapText="true" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>

        <!-- Final Approval Actions (Event 10) -->
        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#finalRejectButton" prefHeight="38.0" prefWidth="130.0" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold;" text="Final Reject" />
                <Button mnemonicParsing="false" onAction="#finalApproveButton" prefHeight="38.0" prefWidth="150.0" style="-fx-background-color: #388E3C; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold;" text="Final Approve" />
            </children>
        </HBox>
    </children>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="580.0" prefWidth="880.0" spacing="20.0" style="-fx-background-color: #F4F6F8;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.Controller.U07.U07G1_DashboardOverviewController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>
    <children>
        <!-- Welcome Banner -->
        <VBox spacing="4.0">
            <children>
                <Label text="Head of DoSA Overview" textFill="#083c57">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Label text="Welcome back! Here is a summary of pending approvals and administrative actions requiring your attention." textFill="#555555">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- Summary Cards Grid (2x2 Layout) -->
        <GridPane hgap="20.0" vgap="20.0" VBox.vgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minWidth="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
                <RowConstraints minWidth="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>

                <!-- Card 1: Pending Event Approvals -->
                <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <children>
                        <HBox alignment="TOP_RIGHT">
                            <children>
                                <StackPane style="-fx-background-color: #E3F2FD; -fx-background-radius: 12; -fx-padding: 4 10 4 10;">
                                    <children>
                                        <Label fx:id="pendingEventsCountLabel" style="-fx-font-weight: bold;" text="0" textFill="#1976D2">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </StackPane>
                            </children>
                        </HBox>
                        <Label style="-fx-font-weight: bold;" text="Major Event Approvals" textFill="#083c57">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Label>
                        <Label text="Review major club events exceeding 50,000 BDT or inter-uni scope" textFill="#777777" wrapText="true">
                            <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                        </Label>
                        <VBox alignment="BOTTOM_RIGHT" VBox.vgrow="ALWAYS">
                            <children>
                                <Button mnemonicParsing="false" onAction="#pendingEventsCardButton" prefHeight="32.0" prefWidth="140.0" style="-fx-background-color: #004975; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;" text="Review Events →" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- Card 2: Pending Budget Reviews -->
                <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <children>
                        <HBox alignment="TOP_RIGHT">
                            <children>
                                <StackPane style="-fx-background-color: #FFF3E0; -fx-background-radius: 12; -fx-padding: 4 10 4 10;">
                                    <children>
                                        <Label fx:id="pendingBudgetCountLabel" style="-fx-font-weight: bold;" text="0" textFill="#F57C00">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </StackPane>
                            </children>
                        </HBox>
                        <Label style="-fx-font-weight: bold;" text="Club Budget Allocation" textFill="#083c57">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Label>
                        <Label text="Adjust annual fundings and finalize university budget limits" textFill="#777777" wrapText="true">
                            <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                        </Label>
                        <VBox alignment="BOTTOM_RIGHT" VBox.vgrow="ALWAYS">
                            <children>
                                <Button mnemonicParsing="false" onAction="#budgetManagementButtonOA" prefHeight="32.0" prefWidth="140.0" style="-fx-background-color: #36649B; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;" text="Manage Budget →" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- Card 3: Active Registered Clubs -->
                <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <children>
                        <HBox alignment="TOP_RIGHT">
                            <children>
                                <StackPane style="-fx-background-color: #E8F5E9; -fx-background-radius: 12; -fx-padding: 4 10 4 10;">
                                    <children>
                                        <Label fx:id="pendingClubCountLabel" style="-fx-font-weight: bold;" text="0" textFill="#388E3C">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </StackPane>
                            </children>
                        </HBox>
                        <Label style="-fx-font-weight: bold;" text="Active Student Clubs" textFill="#083c57">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Label>
                        <Label text="Monitor activity scores, memberships, and performance metrics" textFill="#777777" wrapText="true">
                            <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                        </Label>
                        <VBox alignment="BOTTOM_RIGHT" VBox.vgrow="ALWAYS">
                            <children>
                                <Button mnemonicParsing="false" onAction="#viewClubsOA" prefHeight="32.0" prefWidth="140.0" style="-fx-background-color: #388E3C; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;" text="View Clubs →" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- Card 4: Pending Scholarship Recommendations -->
                <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <children>
                        <HBox alignment="TOP_RIGHT">
                            <children>
                                <StackPane style="-fx-background-color: #EDE7F6; -fx-background-radius: 12; -fx-padding: 4 10 4 10;">
                                    <children>
                                        <Label fx:id="pendingScholarshipsCountLabel" style="-fx-font-weight: bold;" text="0" textFill="#512DA8">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </StackPane>
                            </children>
                        </HBox>
                        <Label style="-fx-font-weight: bold;" text="Scholarship Queue" textFill="#083c57">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Label>
                        <Label text="Final review for welfare-recommended student financial aid" textFill="#777777" wrapText="true">
                            <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                        </Label>
                        <VBox alignment="BOTTOM_RIGHT" VBox.vgrow="ALWAYS">
                            <children>
                                <Button mnemonicParsing="false" onAction="#pendingScholarshipsCardButton" prefHeight="32.0" prefWidth="140.0" style="-fx-background-color: #512DA8; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;" text="Review Queue →" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

            </children>
        </GridPane>
    </children>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="530.0" prefWidth="717.0" spacing="20.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.Controller.U07.U07G4_ReportConfigController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#backToTemplatesButton" style="-fx-background-color: #004975; -fx-text-fill: white; -fx-background-radius: 5;" text="← Back to Templates" />
                <Label style="-fx-text-fill: #083C57; -fx-font-weight: bold;" text="Configure Semester Activity Report">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
            </children>
        </HBox>

        <VBox prefHeight="220.0" prefWidth="677.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #cccccc; -fx-border-radius: 8; -fx-background-radius: 8;">
            <children>
                <Label style="-fx-font-weight: bold; -fx-text-fill: #083C57;" text="Select Target Term Parameters:">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Semester:" />
                                <ComboBox fx:id="semesterComboBox" prefWidth="220.0" promptText="Select Semester" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Academic Year:" />
                                <ComboBox fx:id="yearComboBox" prefWidth="220.0" promptText="Select Year" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Label style="-fx-text-fill: #666666;" text="Note: Generating this report compiles real-time KPI metrics including engagement rate, event success percentage, and overall budget efficiency." wrapText="true">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Label>
            </children>
        </VBox>

        <HBox alignment="CENTER_RIGHT">
            <children>
                <Button mnemonicParsing="false" onAction="#generateReportButton" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #083C57; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold;" text="Generate Report" />
            </children>
        </HBox>
    </children>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="580.0" prefWidth="880.0" spacing="15.0" style="-fx-background-color: #F4F6F8;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.Controller.U07.U07G2_ClubBudgetAllocationController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <!-- Top Navigation & Header -->
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#backToBudgetOverviewButton" style="-fx-background-color: #004975; -fx-text-fill: white; -fx-background-radius: 5;" text="← Back to Overview" />
                <VBox>
                    <children>
                        <Label text="Club Budget Allocation" textFill="#083c57">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <Label text="Adjust annual fundings for active student clubs" textFill="#555555">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Club Budgets Table View (Event 3) -->
        <TableView fx:id="clubBudgetsTableView" prefHeight="430.0" prefWidth="840.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="clubNameTableCC" prefWidth="220.0" text="Club Name" />
                <TableColumn fx:id="currentAllocationTableCC" prefWidth="160.0" text="Current Allocation (BDT)" />
                <TableColumn fx:id="requestedAdditionalTableCC" prefWidth="170.0" text="Requested Additional (BDT)" />
                <TableColumn fx:id="previousYearUsageTableCC" prefWidth="160.0" text="Prev. Year Usage (%)" />
                <TableColumn fx:id="activityScoreTableCC" prefWidth="130.0" text="Activity Score" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Actions Bar -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#adjustButton" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #36649B; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold;" text="Adjust Selected Club" />
            </children>
        </HBox>
    </children>
</VBox>

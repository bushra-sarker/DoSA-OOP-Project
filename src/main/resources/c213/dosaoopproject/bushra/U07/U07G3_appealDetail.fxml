<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="717.0" spacing="12.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.Bushra.Controller.U07.U07G3_AppealDetailController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <!-- Header & Back Button -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#backToQueueButton" style="-fx-background-color: #004975; -fx-text-fill: white; -fx-background-radius: 5;" text="← Back to Queue" />
                <Label style="-fx-text-fill: #083C57; -fx-font-weight: bold;" text="Disciplinary Appeal Review">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
            </children>
        </HBox>

        <!-- Event-5: Warning Banner (Late Submission / Missing Docs) -->
        <HBox fx:id="warningBox" alignment="CENTER_LEFT" prefHeight="35.0" prefWidth="677.0" style="-fx-background-color: #FFEBEE; -fx-border-color: #E57373; -fx-border-radius: 5; -fx-background-radius: 5;" visible="false">
            <children>
                <Label fx:id="warningLabel" style="-fx-text-fill: #C62828; -fx-font-weight: bold;" text="⚠ Warning: Appeal filed beyond 14-day deadline or required documents are missing!" wrapText="true">
                    <HBox.margin>
                        <Insets left="10.0" />
                    </HBox.margin>
                </Label>
            </children>
        </HBox>

        <!-- Incident & Appeal Details Section -->
        <VBox spacing="8.0" style="-fx-background-color: white; -fx-padding: 12; -fx-border-color: #CCCCCC; -fx-border-radius: 5; -fx-background-radius: 5;">
            <children>
                <HBox spacing="10.0">
                    <children>
                        <VBox prefWidth="320.0" spacing="4.0">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="Incident Report:" />
                                <Label fx:id="incidentReportLabel" prefHeight="45.0" prefWidth="315.0" text="Details of the incident..." wrapText="true" />
                            </children>
                        </VBox>
                        <Separator orientation="VERTICAL" prefHeight="50.0" />
                        <VBox prefWidth="320.0" spacing="4.0">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="Original Penalty:" />
                                <Label fx:id="originalPenaltyLabel" prefHeight="45.0" prefWidth="315.0" style="-fx-text-fill: #C62828;" text="Penalty details..." wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <Separator prefWidth="200.0" />
                <Label style="-fx-font-weight: bold;" text="Student Appeal Statement:" />
                <Label fx:id="studentAppealStatementLabel" prefHeight="50.0" prefWidth="650.0" text="Student statement body..." wrapText="true" />

                <Label style="-fx-font-weight: bold;" text="Attached Evidence/Files:" />
                <ListView fx:id="attachedFilesList" prefHeight="60.0" prefWidth="650.0" />
            </children>
        </VBox>

        <!-- Decision Selection Section (Event-6) -->
        <VBox spacing="8.0" style="-fx-background-color: white; -fx-padding: 12; -fx-border-color: #CCCCCC; -fx-border-radius: 5; -fx-background-radius: 5;">
            <children>
                <Label style="-fx-font-weight: bold; -fx-text-fill: #083C57;" text="Select Determination Decision:" />
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <RadioButton fx:id="upholdOriginalButton" mnemonicParsing="false" onAction="#upholdOriginalButton" text="Uphold Original">
                            <toggleGroup>
                                <ToggleGroup fx:id="decisionGroup" />
                            </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="reducePenaltyButton" mnemonicParsing="false" onAction="#reducePenaltyButton" text="Reduce Penalty" toggleGroup="$decisionGroup" />
                        <RadioButton fx:id="dismissChargesButton" mnemonicParsing="false" onAction="#dismissChargesButton" text="Dismiss Charges" toggleGroup="$decisionGroup" />
                    </children>
                </HBox>

                <!-- Reduction Selection Box -->
                <HBox fx:id="penaltyReductionBox" alignment="CENTER_LEFT" spacing="10.0" visible="false">
                    <children>
                        <Label text="New Reduced Penalty:" />
                        <ComboBox fx:id="newPenaltyComboBox" prefWidth="200.0" promptText="Select New Penalty" />
                    </children>
                    <VBox.margin>
                        <Insets top="5.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>

        <!-- Rationale & Finalization (Event-7 & 8) -->
        <VBox spacing="6.0" VBox.vgrow="ALWAYS">
            <children>
                <Label style="-fx-font-weight: bold;" text="Written Decision Rationale (Min 50, Max 1000 characters):" />
                <TextArea fx:id="decisionRationaleTextF" prefHeight="90.0" prefWidth="677.0" promptText="Type official board decision rationale here..." wrapText="true" />
                <HBox alignment="CENTER_RIGHT">
                    <children>
                        <Label fx:id="charCountLabel" style="-fx-text-fill: #666666;" text="Characters: 0 / 1000 (Min: 50)" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Action Controls -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="finalizeButton" disable="true" mnemonicParsing="false" onAction="#finalizeButton" prefHeight="35.0" prefWidth="180.0" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold;" text="Finalize Appeal Decision" />
            </children>
        </HBox>
    </children>
</VBox>
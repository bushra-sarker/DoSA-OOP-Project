<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="c213.dosaoopproject.bushraController.HeadOfDoSAViewController">

    <!-- Top Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #003366; -fx-padding: 15px;" BorderPane.alignment="CENTER">
            <children>
                <Label text="DoSA Portal | Head of DoSA Dashboard" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>

    <!-- Left Sidebar Navigation -->
    <left>
        <VBox prefWidth="220.0" spacing="10.0" style="-fx-background-color: #004675; -fx-padding: 15px;" BorderPane.alignment="CENTER">
            <children>
                <Label text="NAVIGATION" textFill="#b0c4de">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="5.0" />
                    </VBox.margin>
                </Label>

                <Button fx:id="btnDashboard" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#dashboardViewOA" style="-fx-background-color: #36649B; -fx-text-fill: white; -fx-alignment: CENTER-LEFT;" text="Dashboard Overview" />
                <Button fx:id="btnPendingEvents" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#majorEventViewOA" style="-fx-background-color: #004675; -fx-text-fill: white; -fx-alignment: CENTER-LEFT;" text="Major Event Approvals" />
                <Button fx:id="btnBudget" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#budgetManagementOA" style="-fx-background-color: #004675; -fx-text-fill: white; -fx-alignment: CENTER-LEFT;" text="Budget Requests" />
            </children>
        </VBox>
    </left>

    <!-- Dynamic Center Content Area -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #F4F6F9;" BorderPane.alignment="CENTER" />
    </center>
</BorderPane>